# Node 22+ is required (see package.json "engines").
#
# LOCAL DEMO ONLY. Demo mode skips sign-in and gives every visitor the same
# shared sample account. BOTH flags MUST be false (or unset) in production.
BRIX_DEMO_MODE=true
NEXT_PUBLIC_BRIX_DEMO_MODE=true
APP_URL=http://localhost:3000

# Firebase: enable Google and Phone providers, create Firestore, deploy rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Google One Tap: the Web client ID of Firebase's Google provider.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5 when blank.
ANTHROPIC_MODEL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Reserved for SMS/voice and phone verification. Leave blank until configured.
TWILIO_PHONE_NUMBER=
NEXT_PUBLIC_TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_JOIN_CODE=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_SERVER_SECRET=
NEXT_PUBLIC_VAPI_PHONE_NUMBER=
LITHIC_API_KEY=
LITHIC_ENV=sandbox
NEWS_API_KEY=
CRON_SECRET=
ADMIN_EMAILS=
