rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
  match /users/{uid}/{document=**} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
  match /secrets/{document=**} { allow read, write: if false; }
  match /phoneIndex/{document=**} { allow read, write: if false; }
  match /apiKeys/{document=**} { allow read, write: if false; }
  match /smsLimits/{document=**} { allow read, write: if false; }
  match /newsCache/{document=**} { allow read, write: if false; }
  match /portfolios/{document=**} { allow read, write: if false; }
 }
}
